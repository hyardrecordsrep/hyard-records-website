# Copy to functions/.env and fill in. These are settings, not secrets.
# The Stripe keys are secrets: set them with
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Accounts that get the admin page (comma separated, must be confirmed emails)
ADMIN_EMAILS=info@hyardrecords.com

# Where Stripe sends buyers back to
SITE_URL=https://hyardrecords.com

# Receipts after each paid order, sent through Google Workspace (smtp.gmail.com).
# SMTP_USER logs in with a Google app password, set as a secret:
#   firebase functions:secrets:set SMTP_PASSWORD
# RECEIPT_FROM must be a "Send mail as" address of SMTP_USER in Gmail settings.
SMTP_USER=you@hyardrecords.com
RECEIPT_FROM=payments@hyardrecords.com
RECEIPT_COPY_TO=you@hyardrecords.com
# Optional line under the total, e.g. VAT wording
RECEIPT_NOTE=

# Demo emails: "new demo" to DEMO_NOTIFY_TO, and "received" / "status changed" to the artist,
# all from DEMO_FROM (must be a "Send mail as" address of SMTP_USER in Gmail settings)
DEMO_FROM=product@hyardrecords.com
DEMO_NOTIFY_TO=you@hyardrecords.com
