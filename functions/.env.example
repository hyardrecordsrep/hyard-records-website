# Copy to functions/.env and fill in. These are settings, not secrets.
# The Stripe keys are secrets: set them with
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET

# Accounts that get the admin page (comma separated, must be confirmed emails)
ADMIN_EMAILS=info@hyardrecords.com

# Where Stripe sends buyers back to
SITE_URL=https://hyardrecords.com
